{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean",
            "type": "shell",
            "command": "pixi",
            "args": ["run", "clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Clean"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "pixi",
            "args": ["run", "build-fw", "BOARD=${input:boardType}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "clean",
            "problemMatcher": ["$gcc"],
            "detail": "Build firmware"
        }
    ],
    "inputs": [
        {
            "id": "boardType",
            "type": "pickString",
            "description": "Select board type",
            "options": [
                "dingopdm_v7",
                "dingopdm_v8",
                "dingopdmmax_v1",
                "canboard_v2",
                "pt-dpdm4_1"
            ],
            "default": "dingopdm_v7"
        }
    ]
}
